{
    "name": "ibexa-fieldtype-richtext",
    "version": "1.0.0",
    "repository": "https://github.com/ezsystems/ezplatform-fieldtype-richtext.git",
    "private": true,
    "prettier": "@ibexa/eslint-config/prettier",
    "dependencies": {},
    "devDependencies": {
        "@ibexa/eslint-config": "https://github.com/ibexa/eslint-config-ibexa.git#~v2.0.0",
        "@ibexa/frontend-config": "https://github.com/ibexa/frontend-config#^v5.0.0-beta1",
        "@ibexa/ts-config": "https://github.com/ibexa/ts-config-ibexa#2.x",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2"
    },
    "scripts": {
        "test": "yarn prettier-test && yarn eslint-test && yarn ts-test",
        "fix": "yarn prettier-test --write && yarn eslint-test --fix",
        "ts-test": "tsc --noEmit",
        "eslint-test": "eslint \"./src/bundle/Resources/**/*.{js,ts}\" \"./src/bundle/ui-dev/**/*.{js,ts,tsx}\" --no-error-on-unmatched-pattern",
        "prettier-test": "yarn prettier \"./src/bundle/Resources/**/*.{js,ts,scss}\" \"./src/bundle/ui-dev/**/*.{js,ts,tsx}\" --check --no-error-on-unmatched-pattern",
        "postinstall": "yarn ibexa-generate-tsconfig"
    }
}
